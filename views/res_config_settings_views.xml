<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website.social.feed</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website']/block[@id='website_settings']" position="before">
                <block title="Social Feeds" id="social_feeds_settings">
                    <setting
                        id="threads_api_setting"
                        string="Threads"
                        help="Connect a Threads account to display its posts in the Threads Feed block."
                    >
                        <div class="content-group">
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" string="App ID" for="threads_client_id"/>
                                <field name="threads_client_id" class="col-lg-9" placeholder="Threads App ID"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" string="App Secret" for="threads_client_secret"/>
                                <field name="threads_client_secret" class="col-lg-9" password="True" placeholder="Threads App Secret"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" string="Redirect URI" for="threads_redirect_uri"/>
                                <field name="threads_redirect_uri" class="col-lg-9" placeholder="https://aritrz.com/threads/callback"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" string="Connection" for="threads_connected"/>
                                <div class="col-lg-9">
                                    <field name="threads_connected"/>
                                    <span class="text-muted ms-2" invisible="not threads_connected">Connected</span>
                                </div>
                            </div>
                            <div class="row mt16" invisible="not threads_user_id">
                                <label class="col-lg-3 o_light_label" string="Threads User ID" for="threads_user_id"/>
                                <field name="threads_user_id" class="col-lg-9" readonly="1"/>
                            </div>
                            <div class="row mt16" invisible="not threads_token_expires_at">
                                <label class="col-lg-3 o_light_label" string="Token Expires At" for="threads_token_expires_at"/>
                                <field name="threads_token_expires_at" class="col-lg-9" readonly="1"/>
                            </div>
                            <div class="mt16">
                                <button name="action_connect_threads" type="object" string="Connect Threads" class="btn btn-primary" icon="oi-arrow-right"
                                    invisible="threads_connected or not threads_client_id or not threads_client_secret or not threads_redirect_uri"/>
                                <button name="action_connect_threads" type="object" string="Reconnect Threads" class="btn btn-secondary" icon="oi-refresh"
                                    invisible="not threads_connected or not threads_client_id or not threads_client_secret or not threads_redirect_uri"/>
                            </div>
                            <div class="mt8 text-muted">
                                <small>The App Secret and Threads access token stay on the Odoo server and are never exposed to website visitors.</small>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
